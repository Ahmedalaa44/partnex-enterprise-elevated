{
  "buildCommand": "npm run build",
  "framework": "tanstack-start",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/chunks/(.*)",
      "dest": "/chunks/$1"
    },
    {
      "src": "/(index\\.js|favicon-.*|robots\\.txt|sitemap\\.xml|manifest\\.json|site\\.webmanifest)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}
